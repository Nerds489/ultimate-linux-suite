#!/usr/bin/make -f

# Ultimate Linux Suite Debian Build Rules

%:
	dh $@

override_dh_auto_clean:
	./build.sh clean || true

override_dh_auto_install:
	# Create installation directories
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/lib
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/modules
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/menus
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/backends
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/configs
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers
	install -d $(DESTDIR)/usr/bin
	install -d $(DESTDIR)/etc/bash_completion.d
	install -d $(DESTDIR)/usr/share/zsh/site-functions
	install -d $(DESTDIR)/usr/share/fish/vendor_completions.d
	install -d $(DESTDIR)/usr/share/doc/ultimate-linux-suite

	# Install main script
	install -m 755 suite.sh $(DESTDIR)/usr/share/ultimate-linux-suite/suite.sh

	# Create primary wrapper: /usr/bin/ultimate-linux-suite
	printf '#!/usr/bin/env bash\nexec /usr/share/ultimate-linux-suite/suite.sh "$$@"\n' \
		> $(DESTDIR)/usr/bin/ultimate-linux-suite
	chmod 755 $(DESTDIR)/usr/bin/ultimate-linux-suite

	# Create alias wrapper: /usr/bin/ultimate-suite
	printf '#!/usr/bin/env bash\nexec /usr/bin/ultimate-linux-suite "$$@"\n' \
		> $(DESTDIR)/usr/bin/ultimate-suite
	chmod 755 $(DESTDIR)/usr/bin/ultimate-suite

	# Install library files
	install -m 644 lib/*.sh $(DESTDIR)/usr/share/ultimate-linux-suite/lib/

	# Install modules
	install -m 644 modules/*.sh $(DESTDIR)/usr/share/ultimate-linux-suite/modules/

	# Install menus
	install -m 644 menus/*.sh $(DESTDIR)/usr/share/ultimate-linux-suite/menus/

	# Install backends
	install -m 644 backends/*.sh $(DESTDIR)/usr/share/ultimate-linux-suite/backends/

	# Install configs
	cp -r configs/* $(DESTDIR)/usr/share/ultimate-linux-suite/configs/

	# Create driver vault directories
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/realtek-r8152
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/realtek-r8821cu
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/broadcom
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/nvidia
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/amd
	install -d $(DESTDIR)/usr/share/ultimate-linux-suite/drivers/intel

	# Install shell completions for primary command (ultimate-linux-suite)
	if [ -f completions/ultimate-linux-suite.bash ]; then \
		install -m 644 completions/ultimate-linux-suite.bash \
			$(DESTDIR)/etc/bash_completion.d/ultimate-linux-suite; \
	fi
	if [ -f completions/ultimate-linux-suite.zsh ]; then \
		install -m 644 completions/ultimate-linux-suite.zsh \
			$(DESTDIR)/usr/share/zsh/site-functions/_ultimate-linux-suite; \
	fi
	if [ -f completions/ultimate-linux-suite.fish ]; then \
		install -m 644 completions/ultimate-linux-suite.fish \
			$(DESTDIR)/usr/share/fish/vendor_completions.d/ultimate-linux-suite.fish; \
	fi

	# Install shell completions for alias command (ultimate-suite)
	if [ -f completions/ultimate-suite.bash ]; then \
		install -m 644 completions/ultimate-suite.bash \
			$(DESTDIR)/etc/bash_completion.d/ultimate-suite; \
	fi
	if [ -f completions/ultimate-suite.zsh ]; then \
		install -m 644 completions/ultimate-suite.zsh \
			$(DESTDIR)/usr/share/zsh/site-functions/_ultimate-suite; \
	fi
	if [ -f completions/ultimate-suite.fish ]; then \
		install -m 644 completions/ultimate-suite.fish \
			$(DESTDIR)/usr/share/fish/vendor_completions.d/ultimate-suite.fish; \
	fi

	# Install documentation
	if [ -d docs ]; then \
		cp -r docs/* $(DESTDIR)/usr/share/doc/ultimate-linux-suite/; \
	fi

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
